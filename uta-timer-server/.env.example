# ここに書く項目は「初回起動時の初期値」です。
# 2回目以降はブラウザの設定画面(http://localhost:8787/)で変更でき、
# 変更内容はDBに保存されて.envより優先されます。
# つまり、普段はここを編集する必要はほぼありません。

# --- サーバー ---
WS_PORT=8787

# 配信者ID(将来複数配信者に配布した時にDBを分けるためのキー)。
# 自分ひとりで使う間はデフォルトのままでOK。
STREAMER_ID=default

# SQLiteファイルの保存先(省略時はサーバー内の viewers.db)
# DB_PATH=./viewers.db

# --- 以下は初回起動時の初期値(任意) ---
# ENABLE_TWITCH=true
# TWITCH_CHANNEL=your_twitch_channel_name
# TWITCH_COUNT_CHEER=true
# TWITCH_COUNT_SUB=true
# TWITCH_COUNT_SUBGIFT=true
# ENABLE_YOUTUBE=false
# YOUTUBE_API_KEY=your_youtube_api_key
# YOUTUBE_VIDEO_ID=
